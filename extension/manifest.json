{
  "manifest_version": 3,
  "name": "Fake News Detector",
  "version": "1.0.1",
  "description": "Verify selected news text using your Fake News Detector backend.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "Fake News Detector",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}